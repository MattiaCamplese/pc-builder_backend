# Connection string Postgres (Neon). In locale usa quella diretta,
# su Vercel usa quella "pooled" (con -pooler nel nome host).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stringa segreta usata per firmare/verificare i JWT (puoi generarla con: openssl rand -hex 32)
JWT_SECRET=

# Token del sandbox Mailtrap, da https://mailtrap.io (Email Testing -> Inbox -> API token)
MAILTRAP_SANDBOX_TOKEN=
